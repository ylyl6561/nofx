# ============================================================
# NoFX 本地测试环境配置示例
# ============================================================
# 复制此文件为 .env.local 并修改配置
# ============================================================

# 环境标识
APP_ENV=local

# 本地PostgreSQL数据库配置
# 注意：macOS上Homebrew安装的PostgreSQL默认用户是你的系统用户名
# 格式：postgresql://用户名@localhost:5432/数据库名
DATABASE_URL=postgresql://yuliang@localhost:5432/nofx_test?sslmode=disable

# API服务器端口
API_SERVER_PORT=8080

# 日志级别
LOG_LEVEL=debug

# ============================================================
# 本地开发便捷设置
# ============================================================

# 跳过JWT认证（仅本地开发环境有效，生产环境会忽略）
# 设置为 true 后，所有API请求无需提供 Authorization 头
SKIP_AUTH=true

# 跳过OTP验证（仅本地开发环境有效，生产环境会忽略）
# 设置为 true 后，登录时无需输入Google Authenticator验证码
SKIP_OTP=true

# 测试用户配置（跳过认证时使用）
TEST_USER_ID=test-user-local
TEST_USER_EMAIL=test@local.dev
